{
  "name": "@complat/react-spectra-editor",
  "version": "1.8.5",
  "description": "An editor to View and Edit Chemical Spectra data (NMR, IR, MS, CV, UIVIS, XRD, GC, and DSC).",
  "repository": {
    "type": "git",
    "url": "https://github.com/ComPlat/react-spectra-editor"
  },
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.28.0",
    "@complat/react-svg-file-zoom-pan": "1.1.5",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mdi/js": "^7.2.96",
    "@mdi/react": "^1.6.1",
    "@mui/icons-material": "^5.14.9",
    "@mui/material": "^5.14.9",
    "@mui/styles": "^5.14.9",
    "@popperjs/core": "^2.11.8",
    "classnames": "^2.3.2",
    "d3": "^7.8.5",
    "d3-tip": "^0.9.1",
    "jcampconverter": "4.1.0",
    "ml-savitzky-golay-generalized": "1.1.1",
    "prop-types": "^15.8.1",
    "react-dropzone": "^8.0.3",
    "react-quill": "^2.0.0",
    "react-redux": "7.2.9",
    "redux": "^4.1.1",
    "redux-saga": "^1.1.3",
    "redux-undo": "^1.1.0",
    "reselect": "^4.0.0"
  },
  "scripts": {
    "start": "react-scripts --max_old_space_size=12288 start",
    "build": "react-scripts --max_old_space_size=12288 build",
    "compile": "rm -rf dist && NODE_ENV=production babel --ignore 'src/__tests__/**','src/setupTests.js','src/index.js' ./src --out-dir ./dist",
    "test": "react-scripts test --env=jsdom --verbose --testPathIgnorePatterns=./src/__tests__/fixtures/",
    "test:coverage": "CI=true react-scripts test --env=jsdom --verbose --testPathIgnorePatterns=./src/__tests__/fixtures/ --coverage",
    "eject": "react-scripts eject",
    "e2e": "cypress open",
    "docs:diagrams": "bash docs/diagrams/generate.sh",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src --ignore-pattern 'src/__tests__/fixtures/**'"
  },
  "peerDependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.21.5",
    "@babel/core": "^7.21.8",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.21.5",
    "@babel/preset-react": "^7.18.6",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "12.1.5",
    "@types/enzyme": "^3.10.13",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.34",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@wojtekmaj/enzyme-adapter-react-17": "^0.8.0",
    "browserslist": "^4.21.5",
    "cypress": "^13.6.2",
    "enzyme": "^3.11.0",
    "enzyme-to-json": "^3.6.2",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.25.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "postcss-normalize": "^13.0.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-scripts": "5.0.1",
    "react-select": "^4.0.0",
    "redux-logger": "^3.0.6",
    "redux-mock-store": "^1.5.4",
    "typescript": "^5.0.4"
  },
  "main": "dist/app.js",
  "module": "dist/app.js",
  "files": [
    "dist",
    "README.md"
  ],
  "browserslist": [
    "defaults and supports es6-module"
  ],
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "transformIgnorePatterns": [
      "/node_modules/(?!d3|d3-array|internmap|delaunator|robust-predicates)"
    ]
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      [
        "@babel/preset-react",
        {
          "runtime": "automatic"
        }
      ]
    ],
    "plugins": [
      "@babel/plugin-transform-runtime",
      "@babel/plugin-transform-function-name"
    ]
  }
}
